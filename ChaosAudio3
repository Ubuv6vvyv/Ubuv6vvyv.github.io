<!DOCTYPE html>
<html lang="en">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>Enhanced Vocal Synthesizer v2.1 (Corrected)</title>
<style>
:root {
  --bg-color: #1e2d3b;
  --surface-color: #2c3e50;
  --primary-color: #4ecdc4;
  --secondary-color: #f39c12;
  --on-surface-color: #ecf0f1;
  --on-surface-variant-color: #bdc3c7;
  --border-color: #34495e;
  --off-color: #263849;
  --accent-color: #e74c3c;
}

* { box-sizing: border-box; }

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: linear-gradient(135deg, var(--bg-color) 0%, #0f1a24 100%);
  color: var(--on-surface-color);
  display: flex;
  justify-content: center;
  align-items: flex-start;
  margin: 0;
  padding: 10px 5px;
  user-select: none;
  min-height: 100vh;
}

#app-container {
  width: 100%;
  max-width: 400px;
  padding: 12px;
  background: var(--surface-color);
  border-radius: 20px;
  box-shadow: 0 12px 40px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.1);
  border: 1px solid var(--border-color);
  backdrop-filter: blur(10px);
}

.control-group {
  padding: 12px;
  border-radius: 12px;
  margin-bottom: 8px;
  background: rgba(0,0,0,.1);
  border: 1px solid rgba(255,255,255,.05);
}

.label {
  font-size: .65em;
  font-weight: 600;
  margin-bottom: 6px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--on-surface-variant-color);
  text-transform: uppercase;
  letter-spacing: .8px;
}

.section-header {
  margin-bottom: 8px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.grid-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.grid-3 {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 8px;
}

input[type="range"] {
  width: 100%;
  -webkit-appearance: none;
  appearance: none;
  background: transparent;
  cursor: pointer;
  height: 16px;
  margin: 0;
}

input[type="range"]::-webkit-slider-runnable-track {
  background: linear-gradient(90deg, var(--bg-color) 0%, var(--primary-color) 50%, var(--secondary-color) 100%);
  height: 4px;
  border-radius: 2px;
  box-shadow: inset 0 1px 3px rgba(0,0,0,.3);
}

input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  margin-top: -6px;
  background: linear-gradient(135deg, var(--primary-color) 0%, #3498db 100%);
  height: 16px;
  width: 16px;
  border-radius: 50%;
  box-shadow: 0 0 8px var(--primary-color), 0 2px 4px rgba(0,0,0,.3);
  border: 2px solid rgba(255,255,255,.2);
}

.button-container {
  display: flex;
  gap: 10px;
  margin-bottom: 12px;
}

button {
  flex-grow: 1;
  padding: 12px;
  font-size: .8em;
  font-weight: 700;
  border: none;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--primary-color) 0%, #3498db 100%);
  color: #000;
  cursor: pointer;
  transition: all .2s ease;
  box-shadow: 0 4px 12px rgba(78, 205, 196, .3);
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(78, 205, 196, .4);
}

button:active {
  transform: scale(.95);
}

.toggle-btn {
  background: var(--off-color);
  color: var(--on-surface-variant-color);
  padding: 6px 12px;
  font-size: .7em;
  height: 28px;
  flex-grow: 0;
  min-width: 70px;
  box-shadow: none;
}

.toggle-btn.active {
  background: linear-gradient(135deg, var(--accent-color) 0%, #c0392b 100%);
  color: #fff;
  font-weight: 700;
  box-shadow: 0 0 12px rgba(231, 76, 60, .4);
}

.preset-buttons {
  display: flex;
  gap: 6px;
  margin-top: 8px;
}

.preset-buttons button {
  background: var(--off-color);
  color: var(--on-surface-variant-color);
  font-size: .65em;
  padding: 8px;
  flex-grow: 1;
  box-shadow: none;
}

.preset-buttons button.active {
  background: linear-gradient(135deg, var(--secondary-color) 0%, #d35400 100%);
  color: #000;
  font-weight: 700;
  box-shadow: 0 0 8px rgba(243, 156, 18, .4);
}

.value-display {
  font-weight: 600;
  color: var(--primary-color);
  text-shadow: 0 0 4px rgba(78, 205, 196, .3);
}

.hidden-section {
  display: none;
}

.fx-section {
  background: rgba(231, 76, 60, .1);
  border: 1px solid rgba(231, 76, 60, .2);
}

.advanced-section {
  background: rgba(243, 156, 18, .1);
  border: 1px solid rgba(243, 156, 18, .2);
}

.visualizer {
  height: 60px;
  background: rgba(0,0,0,.3);
  border-radius: 8px;
  margin-top: 8px;
  position: relative;
  overflow: hidden;
}

.wave-display {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(180deg, transparent 0%, var(--primary-color) 50%, transparent 100%);
  opacity: .6;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: .3; }
  50% { opacity: .8; }
}

.status-indicator {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-color);
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: .3; }
}
</style>

